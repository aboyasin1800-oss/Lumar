# .NET
**/bin/
**/obj/

# Flutter and Dart
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/local.properties

# Local SDK and drive synchronization artifacts
Tools/FlutterSDK/
.tmp.driveupload/
.tmp.drivedownload/

# IDE and local configuration
.vs/
.vscode/*.user
.vscode/backend.env
*.user
*.suo

# Secrets and local environment configuration
**/appsettings.Local.json
**/.env
**/.wwebjs_auth/
**/.wwebjs_cache/
