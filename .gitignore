_diagnostics/
_validation/
_validation_output/
_validation_obj/

# Campaign media uploads are runtime-only and must not be tracked
Backend/LUMAR_ERP_API_V2/wwwroot/campaign-media/*
!Backend/LUMAR_ERP_API_V2/wwwroot/campaign-media/.gitkeep
