CREATE VIEW VW_Delayed_Orders
AS
SELECT TrackingCode,
       ItemType,
       Status,
       DeliveryDate,
       CASE WHEN IsOnHold = 1 THEN N'موقوف' WHEN Status <> N'تم التسليم'
                                                 AND DATEDIFF(DAY, GETDATE(), DeliveryDate) <= 1 THEN N'⚠️ قريب التسليم' WHEN Status <> N'تم التسليم'
                                                                                                                              AND GETDATE() > DeliveryDate THEN N'🚨 متأخر' ELSE N'طبيعي' END AS Alert_Status
FROM   Production_Tracking;


