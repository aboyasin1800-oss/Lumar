CREATE VIEW VW_Daily_Report
AS
SELECT   CAST (InvoiceDate AS DATE) AS DayDate,
         COUNT(*) AS TotalInvoices,
         SUM(NetAmount) AS TotalSales,
         SUM(PaidAmount) AS TotalPaid,
         SUM(RemainingAmount) AS TotalRemaining
FROM     Invoice_Header
GROUP BY CAST (InvoiceDate AS DATE);


Microsoft.Data.Tools.Diagnostics.Tracer Verbose: 0 : 2026-11-04T22:14:57 : Executing Step 1071, Not Tracked, Type 'CreateElementStep', Section 'User', Operation '1', Ignorable Errors '2714' ([dbo].[VW_Dashboard]:SqlView), Script is as follows: 

CREATE VIEW VW_Dashboard
AS
SELECT (SELECT COUNT(*)
        FROM   Invoice_Header) AS TotalInvoices,
       (SELECT SUM(NetAmount)
        FROM   Invoice_Header) AS TotalSales,
       (SELECT SUM(Profit)
        FROM   Invoice_Details) AS TotalProfit,
       (SELECT COUNT(*)
        FROM   Production_Tracking
        WHERE  Status <> N'تم التسليم') AS PendingOrders,
       (SELECT COUNT(*)
        FROM   Production_Tracking
        WHERE  GETDATE() > DeliveryDate) AS DelayedOrders;


Microsoft.Data.Tools.Diagnostics.Tracer Verbose: 0 : 2026-11-04T22:14:57 : Executing Step 1072, Not Tracked, Type 'CreateElementStep', Section 'User', Operation '1', Ignorable Errors '2714' ([dbo].[VW_Dashboard_Advanced]:SqlView), Script is as follows: 

CREATE VIEW VW_Dashboard_Advanced
AS
SELECT (SELECT COUNT(*)
        FROM   Invoice_Header) AS TotalInvoices,
       (SELECT SUM(NetAmount)
        FROM   Invoice_Header) AS TotalSales,
       (SELECT SUM(Profit)
        FROM   Invoice_Details) AS TotalProfit,
       (SELECT COUNT(*)
        FROM   Production_Tracking
        WHERE  Status <> N'تم التسليم') AS PendingOrders,
       (SELECT COUNT(*)
        FROM   Production_Tracking
        WHERE  GETDATE() > DeliveryDate) AS DelayedOrders,
       (SELECT COUNT(*)
        FROM   Production_Tracking
        WHERE  Status = N'جاهز للاستلام') AS ReadyOrders,
       (SELECT COUNT(*)
        FROM   Fabrics_Inventory
        WHERE  AvailableQuantity < (SELECT CAST (SettingValue AS INT)
                                    FROM   System_Settings
                                    WHERE  SettingName = 'LowStockLimit')) AS LowStockItems;


