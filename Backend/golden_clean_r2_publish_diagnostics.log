CREATE VIEW VW_Final_Salary
AS
SELECT E.EmployeeCode,
       CASE WHEN E.SalaryType = N'ثابت' THEN E.FixedSalary ELSE ISNULL(S.TotalSalary, 0) END AS SalaryBeforeDraws,
       ISNULL(D.TotalDraws, 0) AS TotalDraws,
       CASE WHEN E.SalaryType = N'ثابت' THEN E.FixedSalary - ISNULL(D.TotalDraws, 0) ELSE ISNULL(S.TotalSalary, 0) - ISNULL(D.TotalDraws, 0) END AS NetSalary
FROM   Employees AS E
       LEFT OUTER JOIN
       VW_Total_Employee_Salary AS S
       ON E.EmployeeCode = S.EmployeeCode
       LEFT OUTER JOIN
       VW_Total_Draws AS D
       ON E.EmployeeCode = D.EmployeeCode;


