CREATE TRIGGER TRG_Prevent_Negative_Fabric
    ON Invoice_Details
    INSTEAD OF INSERT
    AS BEGIN
           IF EXISTS (SELECT 1
                      FROM   inserted AS I
                             INNER JOIN
                             Fabrics_Inventory AS F
                             ON I.FabricCode = F.FabricCode
                      WHERE  F.AvailableQuantity < I.FabricRequired)
               BEGIN
                   RAISERROR (N'⚠️ لا يوجد قماش كافي في المخزون', 16, 1);
                   ROLLBACK;
                   RETURN;
               END
           INSERT INTO Invoice_Details (DetailID, InvoiceID, CustomerID, ItemType, FabricCode, Quantity, UnitPrice, FabricRequired, FabricCost, WorkCost, TrackingCode)
           SELECT DetailID,
                  InvoiceID,
                  CustomerID,
                  ItemType,
                  FabricCode,
                  Quantity,
                  UnitPrice,
                  FabricRequired,
                  FabricCost,
                  WorkCost,
                  TrackingCode
           FROM   inserted;
       END


Microsoft.Data.Tools.Diagnostics.Tracer Verbose: 0 : 2026-11-04T22:14:56 : Executing Step 1067, Not Tracked, Type 'CreateElementStep', Section 'User', Operation '1', Ignorable Errors '2111' ([dbo].[TRG_Deduct_Fabric]:SqlDmlTrigger), Script is as follows: 

CREATE TRIGGER TRG_Deduct_Fabric
    ON Invoice_Details
    AFTER INSERT
    AS BEGIN
           UPDATE FI
           SET    FI.UsedQuantity      = FI.UsedQuantity + I.FabricRequired,
                  FI.AvailableQuantity = FI.AvailableQuantity - I.FabricRequired
           FROM   Fabrics_Inventory AS FI
                  INNER JOIN
                  inserted AS I
                  ON FI.FabricCode = I.FabricCode;
       END


