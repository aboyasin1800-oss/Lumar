CREATE TRIGGER TRG_Update_Payments
    ON Payments_Log
    AFTER INSERT
    AS BEGIN
           UPDATE IH
           SET    PaidAmount = ISNULL(PaidAmount, 0) + I.Amount
           FROM   Invoice_Header AS IH
                  INNER JOIN
                  inserted AS I
                  ON IH.InvoiceID = I.InvoiceID;
       END


