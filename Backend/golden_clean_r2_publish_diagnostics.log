CREATE PROCEDURE Scan_Process
@TrackingCode INT, @EmployeeCode NVARCHAR (40)
AS
BEGIN
    DECLARE @NewStatus AS NVARCHAR (50);
    SELECT @NewStatus = WorkStage
    FROM   Employee_Workflow
    WHERE  EmployeeCode = @EmployeeCode;
    UPDATE Production_Tracking
    SET    Status          = @NewStatus,
           CuttingEmployee = CASE WHEN @NewStatus = N'تم القص' THEN @EmployeeCode ELSE CuttingEmployee END,
           SewingEmployee  = CASE WHEN @NewStatus = N'تم الخياطة' THEN @EmployeeCode ELSE SewingEmployee END,
           IroningEmployee = CASE WHEN @NewStatus = N'تم الكوي' THEN @EmployeeCode ELSE IroningEmployee END
    WHERE  TrackingCode = @TrackingCode;
    INSERT  INTO Live_Scan (TrackingCode)
    VALUES                (@TrackingCode);
END


